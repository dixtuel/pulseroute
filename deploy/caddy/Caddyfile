{
    on_demand_tls {
        ask http://app:8000/api/v1/internal/caddy-check
        interval 2m
        burst 5
    }
}

:80, :443 {
    tls {
        on_demand
    }

    reverse_proxy app:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
