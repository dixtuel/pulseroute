# Application Settings
APP_NAME=PulseRoute
APP_ENV=production
PRIMARY_DOMAIN=localhost:8000
SECRET_KEY=change-this-to-a-secure-random-32-character-secret
# Shown on /privacy (JS-obfuscated against scraper bots) as the contact for data-access/deletion
# requests -- KVKK/GDPR data controller contact.
OPERATOR_CONTACT_EMAIL=

# Reject registration if the email's domain has no MX or A record (catches typo/garbage domains
# like user@asdkjhaskjdh). Fails open on DNS timeouts so a flaky resolver never blocks real signups.
ENFORCE_EMAIL_DOMAIN_CHECK=true

# Abuse thresholds, 24-hour deduplication and report retention are fixed in code.

# Database & Cache
DATABASE_URL=postgresql+asyncpg://pulseroute:pulsepass@postgres:5432/pulseroutedb
REDIS_URL=redis://redis:6379/0
# Optional dedicated Redis-compatible click-event stream backend. Leave blank to share REDIS_URL.
# Events are bounded and volatile Redis is not a replacement for Postgres.
ANALYTICS_REDIS_URL=
ANALYTICS_STREAM_MAXLEN=2000

# Rate Limiting & Safe Browsing
RATE_LIMIT_PUBLIC_CREATE=5
ENFORCE_SAFE_BROWSING=true
CUSTOM_DOMAIN_CNAME_TARGET=cname.pulseroute.io

# Custom Domains: default lets any logged-in workspace owner/admin add their own domain.
# Set to false to disable custom-domain onboarding entirely (nobody can add one, logged in or not).
ALLOW_CUSTOM_DOMAINS=true

# Operating mode:
#   false (default) = shared instance -- everyone (including anonymous visitors) can dispatch
#     links off this instance's own PRIMARY_DOMAIN; adding a custom domain is optional.
#   true = bring-your-own-domain -- link creation on the shared PRIMARY_DOMAIN is disabled
#     entirely (anonymous links included); every workspace must add + verify its own custom
#     domain before it can create any link. Requires ALLOW_CUSTOM_DOMAINS=true.
REQUIRE_CUSTOM_DOMAIN=false

# Platform-wide AdSense (single server-administrator account only -- Google AdSense requires
# per-site ownership verification, so there is no per-user/per-workspace monetization option).
# Leave unset to run with no ads at all.
# GLOBAL_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# GLOBAL_ADSENSE_SLOT_ID=XXXXXXXXXX
# ADS_TXT_CONTENT=google.com, pub-XXXXXXXXXXXXXXXX, DIRECT, f08c47fec0942fa0

# Data Retention & Privacy (KVKK & GDPR Compliance)
# Number of days to retain granular click telemetry events. Set to 0 to disable automatic pruning.
ANALYTICS_RETENTION_DAYS=90

# Optional owner moderation panel; route stays 404 until both are configured.
# MODERATION_OWNER_EMAIL=owner@example.com
# MODERATION_OWNER_PASSWORD_HASH=<bcrypt hash; password must be at most 72 UTF-8 bytes>
