{
  "name": "PulseRoute — Instant Cloud Live Demo",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -e .[dev]",
  "postStartCommand": "nohup pulseroute serve --host 0.0.0.0 --port 8000 > /tmp/pulseroute.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "PulseRoute Web Dashboard & API",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
